---

const base = import.meta.env.BASE_URL;


const links = [
	{
		href: base,
		id: "landing",
	},
	{
		href: `${base}projects`,
		id: "projects",
	},
];
---

<nav class="navigation w-16 flex flex-col items-start gap-5">
	{
		links.map((link) => (
			<a
				href={link.href}
				class="block h-20 w-full"
			>
				<div
					class="nav-item h-full w-full"
					data-href={link.href}
					data-id={link.id}
				/>
			</a>
		))
	}

</nav>


<script>
	function updateNavigation() {
		const currentPath = window.location.pathname;
		const base = import.meta.env.BASE_URL;

		document.querySelectorAll(".nav-item").forEach((item) => {
			const href = item.getAttribute("data-href");
			const id = item.getAttribute("data-id");

			if (!href || !id) return;

			const isActive =
				id === "landing"
					? currentPath === base
					: currentPath.startsWith(href);

			item.classList.toggle("active", isActive);
		});
	}

	// Saat halaman pertama dibuka
	updateNavigation();

	// Saat Astro melakukan client-side navigation
	document.addEventListener(
		"astro:page-load",
		updateNavigation
	);
</script>


<style>

	/* ================================
	   NAVIGATION
	================================ */

	.navigation {
		width: 4rem;

		display: flex;
		flex-direction: column;
		align-items: flex-start;

		gap: 1.25rem;
	}


	/* ================================
	   NAV ITEM
	================================ */

	.nav-item {
		position: relative;

		width: 100%;
		height: 4px;

		border-radius: 2px;

		/* background: #ababab; */

		overflow: hidden;
	}


	/* ================================
	   BAR
	================================ */

	.nav-item::before {
		content: "";

		position: absolute;

		inset: 0;

		border-radius: inherit;

		background: linear-gradient(
			to right,
			#22d3ee,
			#3b82f6
		);

		transform-origin: left center;

		transform: scaleX(0.5);

		transition:
			transform 1s ease,
			background-color 0.2s ease;
	}


	/* ================================
	   ACTIVE
	================================ */

	.nav-item.active::before {
		transform: scaleX(1);
	}


	/* ================================
	   HOVER
	================================ */

	/* .nav-item:not(.active):hover::before {
		background: #8a8a8a;

		transform: scaleX(0.7);
	} */


	/* ================================
	   LINK
	================================ */


	.nav-item span {
		display: block;

		width: 100%;
		height: 100%;
	}


	/* ================================
	   LARGE SCREEN
	================================ */

	@media (min-width: 1536px) {

		.nav-item {
			height: 6px;
		}

	}

</style>