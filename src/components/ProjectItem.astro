---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Project = {
	image: ImageMetadata;
	name: string;
	description: string;
	tech: string[];
};

interface Props {
	project: Project;
	i: number;
}

const { project, i } = Astro.props;

const isFirst = i === 0;
const isEven = i % 2 === 0;
---

<div
	class="project-item"
	data-direction={isEven ? "right" : "left"}
	style={`--delay: ${i * 0.15}s`}
>
	<div
		class:list={{
			"project-content flex flex-col items-center justify-center": true,
			"lg:flex-row": isEven,
			"lg:flex-row-reverse": !isEven,
		}}
	>

		<!-- ========================================
		     PROJECT IMAGE
		========================================= -->

		<div class="w-full h-full flex items-center justify-center">

			<Image
				src={project.image}
				alt={project.name}
				width={960}
				height={540}
				format="webp"
				quality={70}
				class="lg:w-[80%] lg:h-[80%] object-cover rounded-sm"
				loading={isFirst ? "eager" : "lazy"}
				decoding="async"
			/>

		</div>


		<!-- ========================================
		     PROJECT INFORMATION
		========================================= -->

		<div
			class="w-full flex flex-col gap-5 p-5! xl:p-10! font-adamina"
		>

			<!-- TITLE -->

			<div
				class="relative w-full flex items-center justify-center"
			>

				<h1
					class="text-center text-sm text-wrap lg:text-xl"
				>
					{project.name}
				</h1>


				<!-- GitHub -->

				<div
					class="absolute right-0 flex items-center"
				>

					<img
						src="https://skillicons.dev/icons?i=github"
						alt="GitHub"
						class="h-6 w-6 md:h-8 md:w-8"
						loading="lazy"
						decoding="async"
					/>

				</div>

			</div>


			<!-- DESCRIPTION -->

			<p
				class="w-full text-justify text-xs lg:text-sm xl:text-lg overflow-hidden"
			>
				{project.description}
			</p>


			<!-- TECH STACK -->

			<div
				class="w-full flex justify-center xl:justify-start"
			>

				<div
					class="flex flex-col items-center gap-2 text-xs lg:flex-row lg:flex-wrap"
				>

					<h3 class="text-sm xl:text-lg">
						Tech Stack:
					</h3>


					<div
						class="flex flex-wrap justify-center gap-2"
					>

						{
							project.tech.map((tech) => (
								<div
									class="flex gap-2 rounded-sm bg-[#1D1D1D] px-3 py-2"
								>
									<h2 class="font-adamina text-xs 2xl:text-lg">
										{tech}
									</h2>
								</div>
							))
						}

					</div>

				</div>

			</div>

		</div>

	</div>
</div>


<script>
	const initProjectObserver = () => {

		const items =
			document.querySelectorAll<HTMLElement>(".project-item");

		if (!items.length) return;


		const observer =
			new IntersectionObserver(
				(entries) => {

					entries.forEach((entry) => {

						if (!entry.isIntersecting) return;

						entry.target.classList.add("is-visible");

						observer.unobserve(entry.target);

					});

				},
				{
					threshold: 0.2,
					rootMargin: "0px 0px -10% 0px",
				}
			);


		items.forEach((item) => {
			observer.observe(item);
		});

	};


	// Initial load + Astro ClientRouter navigation
	document.addEventListener(
		"astro:page-load",
		initProjectObserver
	);
</script>


<style>

	/* ========================================
	   PROJECT CONTENT
	========================================= */

	.project-content {

		width: 100%;
		height: 100%;

		gap: 0;

		opacity: 0;

		transform: translate3d(0, 0, 0);

		transition:
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.6s ease-out;

		transition-delay: var(--delay);

		will-change: transform, opacity;

	}


	/* ========================================
	   SLIDE DIRECTION
	========================================= */

	.project-item[data-direction="right"]
	.project-content {

		transform: translate3d(100px, 0, 0);

	}


	.project-item[data-direction="left"]
	.project-content {

		transform: translate3d(-100px, 0, 0);

	}


	/* ========================================
	   VISIBLE
	========================================= */

	.project-item.is-visible
	.project-content {

		opacity: 1;

		transform: translate3d(0, 0, 0);

	}


	/* ========================================
	   REDUCE MOTION
	========================================= */

	@media (prefers-reduced-motion: reduce) {

		.project-content {

			opacity: 1;

			transform: none !important;

			transition: none;

			will-change: auto;

		}

	}

</style>