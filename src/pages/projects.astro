---

<BaseLayout title="projects">
<div class="h-full page-scroll">

	<div class="w-full flex flex-col ls:gap-24 items-center pt-20! lg:pt-20!">

		<!-- TITLE -->
		<div class="flex items-center h-28 gap-3">
			<h1 class="text-xl xl:text-5xl font-port_lligat_slab font-bold text-transparent bg-clip-text bg-linear-to-r from-cyan-400 to-blue-500">
				What I`ve Been Working On
			</h1>
		</div>


		<!-- PROJECTS -->
		<div class="w-full">

			<div class="w-full flex flex-col items-center justify-center text-neutral-300 gap-5 xl:gap-16">

				{
					projects.map((project, i) => (
						<ProjectItem
							project={project}
							i={i}
						/>
					))
				}

			</div>

		</div>


		<!-- EMAIL -->
		<div class="h-[12dvh] w-full flex items-center xl:pt-0">
			

		</div>

	</div>

</div>
</BaseLayout>